# Database Connection
# You can use a cloud provider like Neon.tech, Supabase, or a local Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/relaydb"

# Authentication Secret (Used by NextAuth to sign JWT tokens)
# Generate one using: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-me"
NEXTAUTH_URL="http://localhost:3000"

# Email Provider Configuration
# Set your Resend API Key here for transactional email delivery.
RESEND_API_KEY="re_123456789_xxxxxxxxxxxxxxxxxxxxxx"

# OAuth Providers (NextAuth)
# Get these from Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Get these from GitHub (Developer Settings -> OAuth Apps)
GITHUB_ID="your-github-oauth-app-id"
GITHUB_SECRET="your-github-oauth-app-secret"
