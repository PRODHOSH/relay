generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  
  // Custom SaaS fields
  projects      Project[]
  templates     Template[]
  emailQueue    EmailQueue[]
  audienceLists AudienceList[]
  systemLogs    SystemLog[]
  
  // SMTP Config (Optional per user)
  emailProvider String? @default("smtp") // "smtp" or "resend"
  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPass      String?
  resendKey     String?
  resendFrom    String?
  senderName    String?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id        String   @id @default(cuid())
  name      String
  type      String   // "dynamic-pdf", "static-pdf", "html-email"
  status    String   @default("Draft") // "Active", "Completed", "Draft"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  emails    EmailQueue[]
}
model Template {
  id         String   @id @default(cuid())
  name       String
  content    String   @db.Text
  format     String   @default("html")
  designJson String?  @db.Text
  variables  String?  @db.Text // JSON array of variable names e.g. ["name","email","role"]
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  emailQueues EmailQueue[] @relation("AttachmentTemplate")
}

model EmailQueue {
  id        String   @id @default(cuid())
  toEmail   String
  subject   String
  content   String   @db.Text // Rendered template content
  status    String   @default("pending") // pending, sent, failed
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  sentAt    DateTime?
  scheduledFor DateTime?

  attachmentTemplateId String?
  attachmentTemplate   Template? @relation("AttachmentTemplate", fields: [attachmentTemplateId], references: [id], onDelete: SetNull)
  attachmentPath       String?   // Path to locally generated PDF attachment
  
  // Tracking & Analytics
  projectId          String?
  project            Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  openedAt           DateTime?
  clickedAt          DateTime?
}

model AudienceList {
  id          String    @id @default(cuid())
  name        String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts    Contact[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Contact {
  id             String       @id @default(cuid())
  audienceListId String
  audienceList   AudienceList @relation(fields: [audienceListId], references: [id], onDelete: Cascade)
  email          String
  firstName      String?
  lastName       String?
  metadata       String?      @db.Text // JSON string for custom attributes
  createdAt      DateTime     @default(now())
}

model SystemLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())
}
